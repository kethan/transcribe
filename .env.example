# Copy to .env locally, or export these in Kaggle "Secrets"/environment.
# Never commit real credentials.

# Default transcription backend: local Bodhan Hugging Face model.
# "cloud" explicitly switches back to the hosted Bodhan API.
ASR_BACKEND=hf-local
HF_ASR_MODEL=bodhan-ai/indic-transcribe-core
# Optional: path to an already-downloaded HF snapshot; no Hub download needed.
# HF_ASR_MODEL_DIR=/kaggle/models/indic-transcribe-core
ASR_COMPUTE_DTYPE=auto
BODHAN_LANGUAGE=gu

# Required to download the gated Bodhan HF repo and the NeMo diarization checkpoint.
# Accept the Bodhan model license once on its Hugging Face page first.
HF_TOKEN=

# Only needed with ASR_BACKEND=cloud. Never used by the default local backend.
# BODHAN_API_KEY=
BODHAN_BASE_URL=https://api.bodhan.ai
BODHAN_MODEL=indic-transcribe

# Optional: NeMo checkpoint override. HF repo id or absolute path to a .nemo file.
NEMO_DIAR_MODEL=nvidia/Nemotron-3-Diarization

# Optional: alignment checkpoints.
ALIGNMENT_MODEL=mms-uroman
ALIGNMENT_LANGUAGE=guj
MMS_ALIGN_MODEL=MahmoudAshraf/mms-300m-1130-forced-aligner
GUJARATI_ALIGN_MODEL=gchhablani/wav2vec2-large-xlsr-gu
PIPELINE_DEVICE=auto

# Optional: speaker-turn keeps full consecutive speaker text in one segment.
# "legacy" restores pause/chunk/sentence/max-duration splitting.
SEGMENTATION_MODE=speaker-turn
